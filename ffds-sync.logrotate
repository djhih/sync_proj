# logrotate config for the FFDS sync chain (v3 ffds_sync.sh)
# Deploy target: sync-host:/etc/logrotate.d/ffds-sync
#
# copytruncate, not create: the script, its workers and the awk filter
# all write via O_APPEND and a multi-hour job would keep writing into a
# renamed file under the default scheme. copytruncate loses at most a
# moment of output instead. The monitor's incremental reader detects
# truncation (size < offset) and resets by itself; a rotated events.log
# only costs the monitor its replay history, not live state.
/var/log/ffds-sync/events.log /var/log/ffds-sync/jobs/*.log {
    weekly
    maxsize 64M
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
